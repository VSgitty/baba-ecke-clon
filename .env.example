# TMDB API Key — required for automatic movie/franchise media (backdrops, logos, posters)
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: protect /admin and write API endpoints with HTTP Basic Auth.
# If both are set, browser auth is required for:
# - /admin/*
# - POST/PUT/PATCH/DELETE on /api/catalog, /api/franchises, /api/shelves
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change_me_to_a_long_random_password
